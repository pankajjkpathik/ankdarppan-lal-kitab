{
  "schema_version": 1,
  "events": {
    "project.checkout_started": {
      "event_schema_version": 1,
      "description": "Customer first interacts with the birth-details checkout form.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      }
    },
    "project.coupon_selected": {
      "event_schema_version": 1,
      "description": "Customer selects an available coupon; eligibility is checked separately.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "coupon"
        ],
        "properties": {
          "coupon": {
            "type": "string",
            "enum": [
              "Follower20",
              "Subscriber50"
            ]
          }
        }
      }
    },
    "project.order_completed": {
      "event_schema_version": 1,
      "description": "Customer confirmation receives a server-verified paid report order; emitted once per order in the browser session.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "amount_paise"
        ],
        "properties": {
          "amount_paise": {
            "type": "integer"
          }
        }
      }
    },
    "project.payment_attempted": {
      "event_schema_version": 1,
      "description": "Customer submits valid birth details to start a Razorpay payment.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "amount_paise",
          "coupon"
        ],
        "properties": {
          "amount_paise": {
            "type": "integer"
          },
          "coupon": {
            "type": "string",
            "enum": [
              "none",
              "Follower20",
              "Subscriber50"
            ]
          }
        }
      }
    }
  }
}
